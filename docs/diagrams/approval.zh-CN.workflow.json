{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Engineering Harness · 批准与验证",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "animation": "none",
    "legend": {
      "mode": "hidden"
    }
  },
  "lanes": [
    {
      "id": "assessment",
      "label": "阶段一 · 只读评估"
    },
    {
      "id": "human",
      "label": "用户决策"
    },
    {
      "id": "implementation",
      "label": "阶段二 · 获批实施"
    }
  ],
  "nodes": [
    {
      "id": "inspect",
      "lane": "assessment",
      "col": 0,
      "type": "database",
      "label": "检查仓库",
      "sublabel": "证据 + L1 / L2 / L3",
      "width": 180,
      "height": 80
    },
    {
      "id": "plan",
      "lane": "assessment",
      "col": 1,
      "type": "backend",
      "label": "提出具体方案",
      "sublabel": "文件 · 优先级 · 验证方式",
      "width": 180,
      "height": 80
    },
    {
      "id": "approve",
      "lane": "human",
      "col": 1,
      "type": "security",
      "label": "用户批准范围",
      "sublabel": "需要明确批准",
      "width": 180,
      "height": 80
    },
    {
      "id": "hold",
      "lane": "human",
      "col": 2,
      "type": "security",
